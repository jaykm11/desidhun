# Copy to mobile/.env and fill in. Every EXPO_PUBLIC_* value is bundled into the
# app, so only put client-safe values here. Restart Expo after any change.

# Cloud Run backend that serves /api/v1/*
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Website used for the /s/<id> share links
EXPO_PUBLIC_APP_BASE_URL=https://desidhun.net

# Firebase web app credentials (Firebase console > Project settings > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyCpi3brLwEWvWKfuZ6PCyXES1x-_SM7VmY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=desidhun.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=desidhun
EXPO_PUBLIC_FIREBASE_APP_ID=1:365609890674:web:2ed07851921d501b7423eb


# Optional. Google sign-in. Leave blank to show only email and password sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=365609890674-2foi94ccmdkpreic16durgvunfcq8gua.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=365609890674-bldr6a9jreb6r107r19j201s0d3gu6e9.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
