# Server-only values. Do not commit a populated .env file.
#
# Cloud Run uses its service account (Application Default Credentials) to
# authenticate with Firebase Admin / Firestore. For local development only,
# set GOOGLE_APPLICATION_CREDENTIALS to a service-account file outside this repo.
GOOGLE_CLOUD_PROJECT=desidhun

# Private Cloud Storage bucket for generated Lyria songs.
# SONG_LIBRARY_BUCKET=desidhun-songs-365609890674
# Vertex currently serves full songs as lyria-3-pro-preview.
# Lyria 3.5 is tried first; generation falls back to Pro if 3.5 is unavailable.
# LYRIA_MODEL=lyria-3-pro-preview

# Vocal / Spoken Word tracks use Google Cloud Text-to-Speech Chirp 3 HD through
# the Cloud Run service account. No TTS API key or environment variable is needed.
# Enable texttospeech.googleapis.com in the deployment project.

# Song rendering is queued through Cloud Tasks so the browser can return
# immediately while Lyria runs in the background.
CLOUD_TASKS_SONG_RENDER_QUEUE=deshi-dhun-song-render
CLOUD_RUN_TASK_URL=https://deshi-dhun-api-365609890674.us-central1.run.app
CLOUD_RUN_TASK_SERVICE_ACCOUNT=deshi-dhun-api@desidhun.iam.gserviceaccount.com

# Gmail SMTP app password for confirmation and receipt emails. Store this only
# in Secret Manager and bind it to Cloud Run as SMTP_APP_PASSWORD.
SMTP_APP_PASSWORD=

# Optional Vertex AI Gemini overrides. Cloud Run uses ADC; no API key is stored.
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_LOCATION=us-central1

# Comma-separated production app origins. Do not use * in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
APP_BASE_URL=http://localhost:5173,http://localhost:8081
# Public Cloud Run URL for PayU callbacks, with no trailing slash.
# It must not point to Firebase Hosting because Hosting routes callback posts
# to the React app.
PAYU_CALLBACK_BASE_URL=http://localhost:8080

# Verified Google-account emails that bypass subscription and lifetime quota.
# Keep this server-only value; separate multiple accounts with commas.
ADMIN_EMAILS=

# Stripe server secret, webhook secret, and INR Price IDs.
# Membership prices should use Stripe Checkout subscriptions. Credit packs are
# one-time Checkout payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_PACK_50=
STRIPE_PRICE_PACK_150=

# PayU India Hosted Checkout. Both values are server-only: never prefix them
# with VITE_ or add them to frontend environment files.
# Use PAYU_ENVIRONMENT=test until sandbox verification is complete.
PAYU_ENVIRONMENT=test
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# Set only after PayU enables recurring mandates/subscriptions for this
# merchant. PayU credit-pack payments work without this setting.
PAYU_SUBSCRIPTIONS_ENABLED=false
