{
  "name": "deshi-dhun-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:development",
    "dev:development": "NODE_ENV=development DOTENV_CONFIG_PATH=.env.development tsx watch src/index.ts",
    "dev:production": "NODE_ENV=production DOTENV_CONFIG_PATH=.env.production tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --packages=external --platform=node --target=node22 --format=esm --outfile=dist/index.mjs",
    "start": "node dist/index.mjs",
    "start:development": "NODE_ENV=development DOTENV_CONFIG_PATH=.env.development node dist/index.mjs",
    "start:production": "NODE_ENV=production DOTENV_CONFIG_PATH=.env.production node dist/index.mjs"
  },
  "dependencies": {
    "18": "^0.0.0",
    "@google-cloud/storage": "^7.22.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.1",
    "nodemailer": "^10.0.10",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
