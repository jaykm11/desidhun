# Vite exposes every VITE_* value to the browser. Never put secrets here.
# Copy this file to .env.development or .env.production.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Public OAuth web client ID used by the YouTube upload permission popup.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# API origin only, with no /api suffix or trailing slash.
VITE_API_BASE_URL=http://localhost:8080